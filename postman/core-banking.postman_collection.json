              "mode": "raw",
              "raw": "{\n  \"address\": \"Avenida Siempre Viva 742\",\n  \"phone\": \"0987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Dirección actualizada\", () => pm.expect(pm.response.json().address).to.eql(\"Avenida Siempre Viva 742\"));"
                ]
              }
            }
          ]
        },
