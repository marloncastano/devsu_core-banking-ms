        {
          "name": "Abrir cuenta de ahorros de Jose Lema (2000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsBaseUrl}}/api/cuentas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 2000,\n  \"customerId\": \"{{joseId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The customers reach accounts-service through RabbitMQ (eventual consistency): give the events a moment.",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Saldo disponible = saldo inicial (2000)\", () => pm.expect(pm.response.json().availableBalance).to.eql(2000));",
                  "pm.collectionVariables.set(\"joseSavings\", pm.response.json().accountNumber);"
                ]
              }
            }
          ]
        },
