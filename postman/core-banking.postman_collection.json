        },
        {
          "name": "F4 - Reporte estado de cuenta de Marianela Montalvo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/reportes?fecha={{fromDate}},{{toDate}}&cliente={{marianelaId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day = d => d.toISOString().slice(0, 10);",
                  "const today = new Date();",
                  "// One day of margin on each side so the time zone of the machine running the collection does not matter.",
                  "pm.collectionVariables.set(\"fromDate\", day(new Date(today.getTime() - 86400000)));",
                  "pm.collectionVariables.set(\"toDate\", day(new Date(today.getTime() + 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const report = pm.response.json();",
                  "pm.test(\"Cliente Marianela Montalvo\", () => pm.expect(report.customerName).to.eql(\"Marianela Montalvo\"));",
                  "pm.test(\"Dos cuentas con sus saldos: corriente 700 y ahorros 0\", () => {",
                  "    const balances = report.accounts.map(a => [a.accountType, a.initialBalance, a.availableBalance]);",
                  "    pm.expect(balances).to.deep.include([\"CHECKING\", 100, 700]);",
                  "    pm.expect(balances).to.deep.include([\"SAVINGS\", 540, 0]);",
                  "});",
                  "pm.test(\"Cada cuenta incluye el detalle de sus movimientos\", () => report.accounts.forEach(a => pm.expect(a.movements).to.have.lengthOf(1)));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run this folder with the Collection Runner: it reproduces the use cases of the specification (customers, accounts, movements, 'Saldo no disponible' and the account statement) and checks every expected balance."
    },
    {
      "name": "2. Clientes (/api/clientes)",
      "item": [
        {
          "name": "Crear cliente de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{customersBaseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Demo\",\n  \"gender\": \"OTHER\",\n  \"birthDate\": \"1995-06-15\",\n  \"identification\": \"{{demoIdentification}}\",\n  \"address\": \"Calle 10\",\n  \"phone\": \"0991234567\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"demoIdentification\", String(Math.floor(1000000000 + Math.random() * 8999999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cliente activo, sin contraseña en la respuesta\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.active).to.eql(true);",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "});",
                  "pm.collectionVariables.set(\"demoCustomerId\", pm.response.json().customerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar clientes (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customersBaseUrl}}/api/clientes?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta paginada\", () => pm.expect(pm.response.json()).to.have.keys(\"content\", \"page\", \"size\", \"totalElements\", \"totalPages\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar cliente por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customersBaseUrl}}/api/clientes/{{demoCustomerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Edad calculada desde la fecha de nacimiento\", () => pm.expect(pm.response.json().age).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar cliente (PATCH parcial)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{customersBaseUrl}}/api/clientes/{{demoCustomerId}}",
