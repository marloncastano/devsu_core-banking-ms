    {
      "name": "4. Movimientos (/api/movimientos)",
      "item": [
        {
          "name": "Registrar depósito con Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{accountsBaseUrl}}/api/movimientos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{joseChecking}}\",\n  \"amount\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No es un reintento\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"false\"));",
                  "pm.collectionVariables.set(\"movementId\", pm.response.json().movementId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reintento con la misma Idempotency-Key (no se aplica dos veces)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{accountsBaseUrl}}/api/movimientos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{joseChecking}}\",\n  \"amount\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Marcado como reintento\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"Devuelve el mismo movimiento\", () => pm.expect(pm.response.json().movementId).to.eql(pm.collectionVariables.get(\"movementId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar movimiento por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/movimientos/{{movementId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Saldo 1250 (1000 + 250, aplicado una sola vez)\", () => pm.expect(pm.response.json().balance).to.eql(1250));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar movimientos de una cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/movimientos?accountNumber={{joseSavings}}&page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Un movimiento\", () => pm.expect(pm.response.json().totalElements).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - Monto cero (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsBaseUrl}}/api/movimientos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{joseChecking}}\",\n  \"amount\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Positive amounts are deposits and negative amounts withdrawals. The optional Idempotency-Key header makes retries safe. Requires folder 1."
    },
    {
      "name": "5. Reportes (/api/reportes)",
      "item": [
        {
          "name": "Reporte estado de cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/reportes?fecha={{fromDate}},{{toDate}}&cliente={{joseId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day = d => d.toISOString().slice(0, 10);",
                  "const today = new Date();",
                  "// One day of margin on each side so the time zone of the machine running the collection does not matter.",
                  "pm.collectionVariables.set(\"fromDate\", day(new Date(today.getTime() - 86400000)));",
                  "pm.collectionVariables.set(\"toDate\", day(new Date(today.getTime() + 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Dos cuentas de Jose Lema\", () => pm.expect(pm.response.json().accounts).to.have.lengthOf(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - Formato de fecha inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/reportes?fecha=10/2/2022&cliente={{joseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - Cliente inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/reportes?fecha=2026-01-01,2026-01-31&cliente=00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ],
      "description": "fecha=start,end (yyyy-MM-dd, inclusive) and cliente=customerId. Requires folder 1."
    }
