{
  "info": {
    "name": "Core Banking - Devsu",
    "description": "Customers (customers-service) and accounts, movements and reports (accounts-service).\n\nRun the whole collection with the Collection Runner: folder 1 reproduces the use cases of the specification and saves the generated ids in collection variables used by the other folders. Change customersBaseUrl and accountsBaseUrl to point to another server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Casos de uso del enunciado",
      "item": [
        {
          "name": "Crear cliente Jose Lema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{customersBaseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose Lema\",\n  \"gender\": \"MALE\",\n  \"birthDate\": \"1985-04-12\",\n  \"identification\": \"{{joseIdentification}}\",\n  \"address\": \"Otavalo sn y principal\",\n  \"phone\": \"098254785\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"joseIdentification\", String(Math.floor(1000000000 + Math.random() * 8999999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cliente activo, sin contraseña en la respuesta\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.active).to.eql(true);",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "});",
                  "pm.collectionVariables.set(\"joseId\", pm.response.json().customerId);"
                ]
              }
            }
          ]
        },
