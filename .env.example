# Copiar a .env y ajustar valores. El archivo .env NO se versiona.

# PostgreSQL (puerto expuesto en el host; 5434 para no chocar con un Postgres local)
DB_USER=devsu
DB_PASSWORD=change-me
DB_PORT=5434

# RabbitMQ
RABBITMQ_USER=devsu
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
