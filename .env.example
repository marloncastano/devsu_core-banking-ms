# Copy to .env and adjust the values. The .env file is NOT versioned.

# PostgreSQL (host port; 5434 avoids clashing with a local PostgreSQL)
DB_USER=devsu
DB_PASSWORD=change-me
DB_PORT=5434

# RabbitMQ
RABBITMQ_USER=devsu
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
